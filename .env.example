# ── Required ─────────────────────────────────────────────────────────────
# One key works across browsers, sandboxes, and desktops. Get it at:
# https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# ── Optional ─────────────────────────────────────────────────────────────
# Port the dashboard listens on (default 3000).
PORT=3000

# Sign-ups are open by default (anyone can make an account; each account's
# jobs and history are private). Set a code to require it when registering.
SIGNUP_CODE=

# SQLite file — accounts, sessions, per-user run history, fleet state.
SCOPE_DB_FILE=.scope.db

# Warn (banner + red KPIs) once observed spend crosses this. 0 = off.
# The dashboard can also set a per-browser budget without restarting.
BUDGET_USD=0

# How often to refresh the fleet, in seconds (default 4).
POLL_SECONDS=4

# ── Reaper ─────────────────────────────────────────────────────
# Kill sandboxes/desktops whose CPU has stayed idle this many minutes. 0 = off.
REAP_IDLE_MINUTES=0
# "dry-run" logs what it would kill without killing. "live" actually kills.
REAP_MODE=dry-run
# CPU% at or below which a session counts as doing nothing.
REAP_CPU_IDLE_PCT=3
# How often to sample each session's live CPU/memory, in seconds.
METRICS_EVERY_SECONDS=20
# Max metric samples per poll (protects a poll from a huge fleet).
METRICS_MAX_PER_TICK=25

# ── Pricing model ──────────────────────────────────────────────
# Solari does not publish a machine-readable price list, so the cost meter
# uses these rates. Override them with your real plan numbers ($/hour).
RATE_SANDBOX_PER_HOUR=0.12
RATE_DESKTOP_PER_HOUR=0.28

# ── Vera + the fan-out runner ──────────────────────────────────
# Vera writes the worker scripts by calling an OpenAI-compatible chat API.
# Put your provider's API key here. Without it the dashboard still works;
# the runner panel is just disabled.
VERA_API_KEY=
# Optional — override to point Vera at a different provider / model.
# VERA_BASE_URL=https://your-provider/v1
# VERA_MODEL=your-model
# Raise if Vera's worker gets cut off on a complex job.
VERA_MAX_TOKENS=4096
# Sandboxes to spin up at once. Set this to your Solari plan's concurrent-
# session limit. On the free tier that is 1 — the runner still fans out, it
# just runs the shards one after another. Too high just means workers wait.
FANOUT_CONCURRENCY=1
FANOUT_MAX_WORKERS=20
# Per-worker hard cap. pip installs + network fetches need headroom.
FANOUT_WORKER_TIMEOUT_MS=120000
# How long a worker waits for a free slot before giving up.
FANOUT_SLOT_WAIT_MS=300000
